# Copy to .env and fill in. Never commit .env.

# --- App -----------------------------------------------------------------------------------
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Set to true when served over HTTPS (required in production)
COOKIE_SECURE=false
ACCESS_TOKEN_TTL_MINUTES=720
ENFORCE_SUBSCRIPTION_LIMITS=true

# --- Database (docker-compose builds DATABASE_URL from these) ----------------------------------
POSTGRES_USER=shoppilot
POSTGRES_PASSWORD=shoppilot
POSTGRES_DB=shoppilot
# Only needed when running the backend outside Docker:
# DATABASE_URL=postgresql+psycopg://shoppilot:shoppilot@localhost:5432/shoppilot

# --- Meta WhatsApp Cloud API (Meta App Dashboard -> WhatsApp -> API Setup) -------------------
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
# App Dashboard -> App settings -> Basic -> App secret (used to verify X-Hub-Signature-256)
META_APP_SECRET=
# Any random string; enter the same value in the webhook configuration in Meta
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0
# test = Meta developer test number (only authorized recipients); production = real number
META_MODE=test
META_HTTP_TIMEOUT_SECONDS=10

# Approved template names in WhatsApp Manager. Leave a name empty if that template is not
# approved yet: the notification is then only possible as free text inside the 24h window.
WA_TEMPLATE_LANGUAGE=en
WA_TEMPLATE_ORDER_CONFIRMED=order_confirmation
WA_TEMPLATE_ORDER_SHIPPED=order_shipped
WA_TEMPLATE_ORDER_DELIVERED=order_delivered

WEBHOOK_EVENT_RETENTION_DAYS=30

# --- Host ports for docker compose -----------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
